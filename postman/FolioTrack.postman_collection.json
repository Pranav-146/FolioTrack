    {
      "name": "Orders",
      "description": "POST and GET /api/users/{id}/orders. BUY then SELL the same share so a run leaves cash and holdings unchanged.",
      "item": [
        {
          "name": "Place BUY order (FILLED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"symbol\": \"KO\",\n  \"side\": \"BUY\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.test(\"Order is FILLED at the current price\", function () {",
                  "    pm.expect(o.symbol).to.eql(\"KO\");",
                  "    pm.expect(o.side).to.eql(\"BUY\");",
                  "    pm.expect(o.quantity).to.eql(1);",
                  "    pm.expect(o.status).to.eql(\"FILLED\");",
                  "    pm.expect(o.rejectionReason).to.be.null;",
                  "    pm.expect(o.priceAtExecution).to.eql(Number(pm.collectionVariables.get(\"koOriginalPrice\")));",
                  "});",
                  "pm.collectionVariables.set(\"buyOrderId\", o.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Portfolio reflects the BUY",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "portfolio"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "const cents = n => Math.round(n * 100);",
                  "pm.test(\"Cash went down by the price of one KO share\", () =>",
                  "    pm.expect(cents(p.cashBalance)).to.eql(",
                  "        cents(pm.collectionVariables.get(\"cashBefore\")) - cents(pm.collectionVariables.get(\"koOriginalPrice\"))));",
                  "pm.test(\"Holds KO\", () => pm.expect(p.holdings.map(h => h.symbol)).to.include(\"KO\"));"
                ]
              }
            }
          ]
        },
