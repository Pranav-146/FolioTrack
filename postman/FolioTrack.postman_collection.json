    {
      "name": "Portfolio",
      "description": "GET /api/users/{id}/portfolio",
      "item": [
        {
          "name": "Get portfolio",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}/portfolio",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}",
                "portfolio"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const p = pm.response.json();",
                  "pm.test(\"Has cash, holdings and totals\", function () {",
                  "    pm.expect(p).to.have.all.keys(\"userId\", \"name\", \"cashBalance\", \"holdings\", \"totalMarketValue\",",
                  "        \"totalCostBasis\", \"totalUnrealizedPnl\", \"totalValue\");",
                  "    pm.expect(p.userId).to.eql(Number(pm.environment.get(\"userId\")));",
                  "    pm.expect(p.holdings).to.be.an(\"array\");",
                  "});",
                  "// Work in cents so floating-point JSON numbers compare exactly",
                  "const cents = n => Math.round(n * 100);",
                  "pm.test(\"totalValue = cash + market value of holdings\", () =>",
                  "    pm.expect(cents(p.totalValue)).to.eql(cents(p.cashBalance) + cents(p.totalMarketValue)));",
                  "pm.test(\"Each holding's P&L = market value - cost basis\", function () {",
                  "    p.holdings.forEach(h => pm.expect(cents(h.unrealizedPnl)).to.eql(cents(h.marketValue) - cents(h.costBasis)));",
                  "});",
                  "pm.collectionVariables.set(\"cashBefore\", p.cashBalance);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get portfolio - unknown user (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{unknownUserId}}/portfolio",
