                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Newest transactions match this run's SELL then BUY\", function () {",
                  "    const [sell, buy] = page.content;",
                  "    pm.expect(sell.orderId).to.eql(Number(pm.collectionVariables.get(\"sellOrderId\")));",
                  "    pm.expect(sell.type).to.eql(\"SELL\");",
                  "    pm.expect(buy.orderId).to.eql(Number(pm.collectionVariables.get(\"buyOrderId\")));",
                  "    pm.expect(buy.type).to.eql(\"BUY\");",
                  "    pm.expect(sell.amount).to.eql(buy.amount);",
                  "});",
                  "pm.test(\"Rejected orders create no transaction\", () =>",
                  "    pm.expect(page.content.map(t => t.orderId)).to.not.include(Number(pm.collectionVariables.get(\"rejectedOrderId\"))));"
                ]
