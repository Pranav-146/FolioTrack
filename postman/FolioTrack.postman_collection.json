                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const page = pm.response.json();",
                  "pm.test(\"Is a page of at most 5 orders\", function () {",
                  "    pm.expect(page).to.have.all.keys(\"content\", \"page\", \"size\", \"totalElements\", \"totalPages\");",
                  "    pm.expect(page.page).to.eql(0);",
                  "    pm.expect(page.size).to.eql(5);",
                  "    pm.expect(page.content.length).to.be.at.most(5);",
                  "});",
                  "pm.test(\"Newest first: this run's orders lead the list\", function () {",
                  "    const ids = page.content.map(o => o.id);",
                  "    const sell = Number(pm.collectionVariables.get(\"sellOrderId\"));",
                  "    const buy = Number(pm.collectionVariables.get(\"buyOrderId\"));",
                  "    const rejected = Number(pm.collectionVariables.get(\"rejectedOrderId\"));",
                  "    pm.expect(ids).to.include.members([rejected, sell, buy]);",
                  "    pm.expect(ids.indexOf(rejected)).to.be.below(ids.indexOf(sell));",
                  "    pm.expect(ids.indexOf(sell)).to.be.below(ids.indexOf(buy));",
                  "});",
                  "pm.test(\"REJECTED orders are kept in history\", () =>",
                  "    pm.expect(page.content.map(o => o.status)).to.include(\"REJECTED\"));"
                ]
              }
            }
