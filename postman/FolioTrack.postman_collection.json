{
  "info": {
    "name": "FolioTrack API",
    "description": "End-to-end tests for every FolioTrack endpoint. Run the folders in order (they share state through collection variables). Uses the seeded data: pick a user with no KO holding (default userId=2). Each run adds two REJECTED orders, which is expected: rejections are kept for audit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "    pm.test(\"Error body has the standard ApiError shape\", function () {",
          "        const body = pm.response.json();",
          "        pm.expect(body).to.have.all.keys(\"timestamp\", \"status\", \"error\", \"message\", \"path\", \"fieldErrors\");",
          "        pm.expect(body.status).to.eql(pm.response.code);",
          "        pm.expect(body.message).to.be.a(\"string\").and.not.empty;",
          "        pm.expect(body.path).to.eql(\"/\" + pm.request.url.path.join(\"/\"));",
          "        pm.expect(body.fieldErrors).to.be.an(\"array\");",
          "        pm.expect(new Date(body.timestamp).toString()).to.not.eql(\"Invalid Date\");",
          "    });",
          "}",
          "pm.test(\"Response time is under 2s\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "variable": [],
  "item": [
    {
      "name": "Instruments",
      "description": "GET /api/instruments and PUT /api/instruments/{symbol}/price",
      "item": [
        {
          "name": "List instruments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/instruments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "instruments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"Returns the seeded instruments sorted by symbol\", function () {",
                  "    pm.expect(list).to.be.an(\"array\").with.length.at.least(10);",
                  "    const symbols = list.map(i => i.symbol);",
                  "    pm.expect(symbols).to.include.members([\"AAPL\", \"MSFT\", \"KO\"]);",
                  "    pm.expect(symbols).to.eql([...symbols].sort());",
                  "});",
                  "pm.test(\"Every instrument has a positive price and an update time\", function () {",
                  "    list.forEach(i => {",
                  "        pm.expect(i).to.have.all.keys(\"symbol\", \"name\", \"currentPrice\", \"updatedAt\");",
                  "        pm.expect(i.currentPrice).to.be.a(\"number\").above(0);",
                  "    });",
                  "});",
                  "// Remember KO's price so the last request in this folder can put it back",
                  "pm.collectionVariables.set(\"koOriginalPrice\", list.find(i => i.symbol === \"KO\").currentPrice);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update price",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/instruments/KO/price",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "instruments",
                "KO",
                "price"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 71.25\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Price is updated\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.symbol).to.eql(\"KO\");",
                  "    pm.expect(body.currentPrice).to.eql(71.25);",
                  "});"
                ]
              }
            }
          ]
        },
