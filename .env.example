# Copy to .env and change the password. .env is gitignored; never commit real secrets.
# Read by both docker-compose (Postgres container) and Spring Boot (spring.config.import).
POSTGRES_DB=foliotrack
POSTGRES_USER=foliotrack
POSTGRES_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Login for the read-only role created by migration V3 (it can only SELECT from the v_my_* views)
DB_READONLY_USER=foliotrack_readonly
DB_READONLY_PASSWORD=change-me-too
# GenAI "ask your portfolio" (Google Gemini). Get a free key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
